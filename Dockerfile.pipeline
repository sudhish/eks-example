FROM python:3.11-slim

WORKDIR /app

# Set environment variables for proper home directory
ENV HOME=/home/appuser
ENV DBT_PROFILES_DIR=/app/dbt_project

# Install UV
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Copy dependency files
COPY pyproject.toml .python-version ./

# Install dependencies using UV
RUN uv pip install --system --no-cache -r pyproject.toml

# Install DBT
RUN uv pip install --system dbt-core dbt-duckdb

# Copy application code
COPY cdc_pipeline /app/cdc_pipeline
COPY dbt_project /app/dbt_project
COPY sql_scripts /app/sql_scripts

# Create necessary directories with proper permissions
RUN mkdir -p /data /home/appuser/.dbt && \
    chmod -R 777 /data /home/appuser

CMD ["python", "/app/cdc_pipeline/orchestrator.py"]
